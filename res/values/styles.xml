<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fond de l'icône : le crème de la marque. Il se distingue mal d'un fond
         d'écran très clair ; passer à @color/brand_deep si le cas se pose. -->
    <color name="ic_launcher_background">#FDFBF4</color>
    <color name="brand_deep">#14593A</color>
    <color name="cream">#FDFBF4</color>

    <!-- targetSdk 34 : la barre système garde sa place, la WebView ne passe pas dessous.
         Le vert profond encadre l'app en haut et en bas, dans les deux thèmes. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@color/brand_deep</item>
        <item name="android:navigationBarColor">@color/brand_deep</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>
</resources>
